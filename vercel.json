{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/*.js": {
      "includeFiles": "{templates/**,tools/**,lib/**,public/mirror/framerusercontent.com/sites/**,public/create/**,public/templates/**,public/couples/**,public/tpl/**}"
    }
  },
  "rewrites": [
    {
      "source": "/mirror/framerusercontent.com/sites/(.*)",
      "destination": "/api/couple-bundle?path=$1"
    },
    {
      "source": "/api/razorpay/order",
      "destination": "/api/razorpay-order"
    },
    {
      "source": "/api/razorpay/verify",
      "destination": "/api/razorpay-verify"
    },
    {
      "source": "/preview/:token",
      "destination": "/api/serve-preview?token=:token"
    },
    {
      "source": "/:slug",
      "destination": "/api/serve-couple?slug=:slug"
    },
    {
      "source": "/:slug/",
      "destination": "/api/serve-couple?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/mirror/framerusercontent.com/sites/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/mirror/framerusercontent.com/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/mirror/framerusercontent.com/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/mirror/images.unsplash.com/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/mirror/fonts.gstatic.com/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "trailingSlash": false
}
