{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": "public",
  "framework": null,
  "routes": [
    { "src": "/mirror/(.*)", "has": [{ "type": "query", "key": "scale-down-to" }], "dest": "/mirror/$1" },
    { "src": "/mirror/(.*)", "has": [{ "type": "query", "key": "width" }], "dest": "/mirror/$1" },
    { "src": "/mirror/(.*)", "has": [{ "type": "query", "key": "height" }], "dest": "/mirror/$1" },
    { "src": "/mirror/(.*)", "has": [{ "type": "query", "key": "w" }], "dest": "/mirror/$1" },
    { "src": "/mirror/(.*)", "has": [{ "type": "query", "key": "h" }], "dest": "/mirror/$1" },
    { "src": "/mirror/(.*)", "has": [{ "type": "query", "key": "fit" }], "dest": "/mirror/$1" },
    { "src": "/mirror/(.*)", "has": [{ "type": "query", "key": "q" }], "dest": "/mirror/$1" }
  ],
  "headers": [
    {
      "source": "/mirror/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "trailingSlash": false
}
