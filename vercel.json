{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": "public",
  "framework": null,
  "routes": [
    {
      "src": "/mirror/(.*)\\.(png|webp|jpg|jpeg|gif|avif)",
      "dest": "/mirror/$1.$2"
    }
  ],
  "headers": [
    {
      "source": "/mirror/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "trailingSlash": false
}
