{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": "public",
  "framework": null,
  "routes": [
    { "src": "/mirror/images\\.unsplash\\.com/(photo-[^/.]+)", "has": [{ "type": "query", "key": "w" }], "dest": "/mirror/images.unsplash.com/$1.jpg" },
    { "src": "/mirror/images\\.unsplash\\.com/(photo-[^/.]+)", "has": [{ "type": "query", "key": "h" }], "dest": "/mirror/images.unsplash.com/$1.jpg" },
    { "src": "/mirror/images\\.unsplash\\.com/(photo-[^/.]+)", "has": [{ "type": "query", "key": "fit" }], "dest": "/mirror/images.unsplash.com/$1.jpg" },
    { "src": "/mirror/(.*)", "has": [{ "type": "query", "key": "scale-down-to" }], "dest": "/mirror/$1" },
    { "src": "/mirror/(.*)", "has": [{ "type": "query", "key": "width" }], "dest": "/mirror/$1" },
    { "src": "/mirror/(.*)", "has": [{ "type": "query", "key": "height" }], "dest": "/mirror/$1" },
    { "src": "/mirror/(.*)", "has": [{ "type": "query", "key": "w" }], "dest": "/mirror/$1" },
    { "src": "/mirror/(.*)", "has": [{ "type": "query", "key": "h" }], "dest": "/mirror/$1" },
    { "src": "/mirror/(.*)", "has": [{ "type": "query", "key": "fit" }], "dest": "/mirror/$1" },
    { "src": "/mirror/(.*)", "has": [{ "type": "query", "key": "q" }], "dest": "/mirror/$1" }
  ],
  "headers": [
    {
      "source": "/mirror/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/mirror/images\\.unsplash\\.com/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/jpeg"
        }
      ]
    }
  ],
  "trailingSlash": false
}
